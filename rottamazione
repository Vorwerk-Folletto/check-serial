<script>

const AUTH_KEY =
"auth_ok";

let selectedModel =
"";


/* CONTROLLO ACCESSO */

if(
  localStorage.getItem(AUTH_KEY)
  !==
  "1"
){

  window.location.href =
  "./index.html?v=5";

}


/* VIBRAZIONE */

function haptic(
  type = "light"
){

  try{

    if(
      navigator.vibrate
    ){

      navigator.vibrate(
        type === "heavy"
        ? 40
        : 18
      );

    }

  }catch(e){}

}


/* HOME */

function goHome(){

  window.location.href =
  "./index.html?v=5";

}


/* SELEZIONE MODELLO */

function selectModel(card){

  document
  .querySelectorAll(
    ".modelCard"
  )
  .forEach(
    c =>
    c.classList.remove(
      "selected"
    )
  );


  card.classList.add(
    "selected"
  );


  selectedModel =
  card.dataset.model;


  document
  .getElementById(
    "selectedModel"
  )
  .textContent =
  selectedModel;


  document
  .getElementById(
    "selectedPanel"
  )
  .classList.add(
    "show"
  );


  localStorage.setItem(
    "folletto_rottamazione_modello",
    selectedModel
  );


  haptic();

}


/* ANNULLA */

function clearSelection(){

  selectedModel =
  "";


  localStorage.removeItem(
    "folletto_rottamazione_modello"
  );


  document
  .querySelectorAll(
    ".modelCard"
  )
  .forEach(
    c =>
    c.classList.remove(
      "selected"
    )
  );


  document
  .getElementById(
    "selectedPanel"
  )
  .classList.remove(
    "show"
  );


  haptic();

}


/* CONFERMA */

function confirmSelection(){

  if(
    !selectedModel
  ){
    return;
  }


  localStorage.setItem(
    "folletto_rottamazione_modello",
    selectedModel
  );


  showToast(
    "Inserito: " +
    selectedModel
  );


  haptic(
    "heavy"
  );

}


/* MESSAGGIO */

function showToast(text){

  const toast =
  document.getElementById(
    "toast"
  );


  toast.textContent =
  text;


  toast.classList.add(
    "show"
  );


  setTimeout(
    () => {

      toast
      .classList.remove(
        "show"
      );

    },
    1800
  );

}


/* CLICK SUI MODELLI */

document
.querySelectorAll(
  ".modelCard"
)
.forEach(
  card => {

    card.addEventListener(
      "click",
      () =>
      selectModel(card)
    );

  }
);


/* RICERCA */

document
.getElementById(
  "modelSearch"
)
.addEventListener(
  "input",
  (e) => {

    const q =
    e.target.value
    .trim()
    .toLowerCase();


    document
    .querySelectorAll(
      ".modelCard"
    )
    .forEach(
      card => {

        const testo =
        (
          card.dataset.search +
          " " +
          card.dataset.model
        )
        .toLowerCase();


        card.style.display =
        testo.includes(q)
        ? ""
        : "none";

      }
    );

  }
);


/* RIPRISTINA SELEZIONE */

const previous =
localStorage.getItem(
  "folletto_rottamazione_modello"
);


if(previous){

  const card =
  [
    ...document.querySelectorAll(
      ".modelCard"
    )
  ]
  .find(
    c =>
    c.dataset.model
    ===
    previous
  );


  if(card){

    selectModel(card);

  }

}

</script>

