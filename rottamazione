<style>

:root{

  --green:#25d366;
  --green2:#1ebea5;
  --blue:#25788f;

  --txt:#102a33;
  --muted:#6a7e86;

  --red:#d72638;

}

*{

  box-sizing:border-box;

  -webkit-tap-highlight-color:
  transparent;

}


body{

  margin:0;

  min-height:100vh;

  font-family:
  'Segoe UI',
  Arial,
  sans-serif;

  background:
  linear-gradient(
    135deg,
    #eef7f9,
    #e2e8ec
  );

  color:var(--txt);

}


/* BARRA SOPRA */

.topbar{

  position:sticky;

  top:0;

  z-index:100;

  display:flex;

  align-items:center;

  gap:12px;

  padding:14px;

  background:
  rgba(255,255,255,.94);

  backdrop-filter:
  blur(14px);

  box-shadow:
  0 5px 25px
  rgba(0,0,0,.07);

}


.back{

  width:44px;

  height:44px;

  border:0;

  border-radius:13px;

  background:#eef5f7;

  color:var(--blue);

  font-size:18px;

  cursor:pointer;

}


.topText{

  text-align:left;

}


.topTitle{

  font-weight:900;

  font-size:19px;

}


.topSub{

  font-size:12px;

  color:var(--muted);

  margin-top:2px;

}


/* CONTENUTO */

.wrap{

  width:min(920px,100%);

  margin:0 auto;

  padding:
  20px 14px 36px;

}


/* TESTATA VERDE */

.hero{

  padding:22px;

  border-radius:22px;

  color:#fff;

  text-align:left;

  background:
  linear-gradient(
    120deg,
    #119447,
    #25b864
  );

  box-shadow:
  0 18px 50px
  rgba(17,148,71,.20);

  margin-bottom:18px;

}


.hero h1{

  margin:
  0 0 7px;

  font-size:27px;

}


.hero p{

  margin:0;

  line-height:1.4;

  font-size:14px;

  opacity:.94;

}


/* RICERCA */

.searchBox{

  display:flex;

  align-items:center;

  gap:10px;

  background:#fff;

  border-radius:15px;

  padding:
  11px 14px;

  box-shadow:
  0 10px 30px
  rgba(0,0,0,.06);

  margin-bottom:17px;

}


.searchBox i{

  color:var(--blue);

}


.searchBox input{

  border:0;

  outline:0;

  width:100%;

  font-size:16px;

  color:var(--txt);

  background:transparent;

}


/* GRIGLIA */

.grid{

  display:grid;

  grid-template-columns:
  repeat(
    2,
    minmax(0,1fr)
  );

  gap:14px;

}


/* SCHEDA MODELLO */

.modelCard{

  position:relative;

  overflow:hidden;

  border:0;

  padding:0;

  background:#fff;

  border-radius:20px;

  box-shadow:
  0 16px 45px
  rgba(0,0,0,.08);

  cursor:pointer;

  text-align:left;

  transition:
  transform .1s ease,
  box-shadow .1s ease;

}


.modelCard:active{

  transform:
  scale(.985);

}


.modelCard.selected{

  outline:
  4px solid
  rgba(37,211,102,.38);

  box-shadow:
  0 18px 50px
  rgba(37,211,102,.18);

}


/* FOTO */

.photo{

  height:235px;

  background:#f6f8f8;

  position:relative;

  overflow:hidden;

  display:flex;

  align-items:center;

  justify-content:center;

}


.photo img{

  width:100%;

  height:100%;

  object-fit:contain;

  padding:10px;

  display:block;

}


/* SCRITTA ROTTAMAZIONE */

.ribbon{

  position:absolute;

  left:10px;

  top:10px;

  z-index:4;

  background:
  rgba(215,38,56,.94);

  color:#fff;

  font-weight:900;

  font-size:12px;

  letter-spacing:.8px;

  padding:
  8px 11px;

  border-radius:999px;

  box-shadow:
  0 7px 22px
  rgba(215,38,56,.22);

}


.cardBody{

  padding:
  13px 14px 15px;

}


.modelName{

  font-size:19px;

  font-weight:900;

  margin:
  0 0 4px;

}


.modelDesc{

  font-size:12px;

  color:var(--muted);

  margin:0;

  line-height:1.35;

}


.selectLine{

  margin-top:11px;

  display:flex;

  align-items:center;

  justify-content:
  space-between;

  color:#138a4b;

  font-size:13px;

  font-weight:900;

}


/* MODELLO SELEZIONATO */

.selectedPanel{

  display:none;

  position:sticky;

  bottom:12px;

  margin-top:18px;

  padding:14px;

  border-radius:18px;

  background:#102a33;

  color:#fff;

  box-shadow:
  0 18px 55px
  rgba(0,0,0,.24);

  z-index:80;

}


.selectedPanel.show{

  display:block;

}


.selectedLabel{

  font-size:12px;

  opacity:.72;

}


.selectedModel{

  font-size:21px;

  font-weight:900;

  margin-top:2px;

}


.actions{

  display:flex;

  gap:9px;

  margin-top:11px;

}


.actionBtn{

  flex:1;

  border:0;

  border-radius:12px;

  padding:
  12px 9px;

  font-weight:900;

  cursor:pointer;

  font-size:14px;

}


.actionPrimary{

  background:
  linear-gradient(
    90deg,
    var(--green),
    var(--green2)
  );

  color:#fff;

}


.actionLight{

  background:#fff;

  color:#102a33;

}


/* NOTIFICA */

.toast{

  position:fixed;

  left:50%;

  bottom:28px;

  transform:
  translateX(-50%)
  translateY(20px);

  opacity:0;

  pointer-events:none;

  background:#111;

  color:#fff;

  padding:
  11px 15px;

  border-radius:999px;

  font-size:13px;

  font-weight:800;

  z-index:999;

  transition:.2s ease;

}


.toast.show{

  opacity:1;

  transform:
  translateX(-50%)
  translateY(0);

}


@media(max-width:620px){

  .grid{

    grid-template-columns:
    1fr;

  }

  .photo{

    height:270px;

  }

}

</style>

</head>


